# ShipSafe local configuration — example only.
#
# Copy to `.env` in the repository root. `.env` is git-ignored.
# `python scripts/dev.py` reads SHIPSAFE_* lines from `.env`; if you start
# uvicorn yourself, export the variables in your shell instead.
# Every variable is optional. Nothing here is a secret, and ShipSafe needs no
# secret to run. Full reference: docs/CONFIGURATION.md

# Extra directory whose Git repositories may be scanned, in addition to the
# synthetic demo repository (which is always allowed). Unset = demo only.
# Must be a specific, approved workspace directory; a drive or filesystem
# root is refused at startup.
# SHIPSAFE_ALLOWED_ROOT=C:\work\approved-repos

# SQLite file for scan history and imported reviews.
# Default: backend/.shipsafe-data/scans.db
# SHIPSAFE_DB_PATH=

# Where the synthetic LedgerLite demo repository is generated.
# Default: backend/demo-repo
# SHIPSAFE_DEMO_DIR=

# Frontend only (read by Vite at build/dev time, put it in frontend/.env.local):
# base URL of the API. Leave unset to use the dev-server /api proxy.
# VITE_API_BASE=

# ---------------------------------------------------------------------------
# NOT IMPLEMENTED: Bitbucket. No code reads any Bitbucket setting in Phase 1.
# Phase 2 will define variable names here. When it does, credentials must be
# read-only, live only in your local `.env` or an approved secret store, and
# never be committed, logged, or sent to the browser.
# ---------------------------------------------------------------------------
